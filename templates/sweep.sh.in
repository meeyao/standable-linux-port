# sweep.sh - shared stale-wineserver sweep, sourced by launch_serverhelper.sh
# and standable_launch_hook.sh (deployed next to them as sweep.sh).
#
# Contract: the caller sets PROTON (proton executable) and
# STEAM_COMPAT_DATA_PATH (this game's compat dir) before sourcing/calling.
# No placeholders - this file is copied verbatim, like proton_resolve.sh.
#
# A wineserver from a PREVIOUS Proton holding this prefix blocks the new
# Proton ("version mismatch ... wrong wineserver still running" -> instant
# exit), seen when switching builds without a Steam restart. It also catches
# the orphaned steam.exe/ignition_server.exe Wine tree left behind when
# SteamVR force-aborts shutdown. Kill only Wine processes from another Proton
# build inside OUR prefix; ours and other prefixes untouched.

# logh - the helper defines one; the hook doesn't, so default to a no-op.
type logh >/dev/null 2>&1 || logh() { :; }

# proc_lines - "pid cmdline" for each process matching regex $1. Pure-bash on
# purpose: the driver runs inside the Sniper sandbox, which has no ps/pgrep (and
# we can't assume awk). Splits the NUL-separated cmdline with the `read` builtin
# - `$(tr '\0' ' ' ...)` forked once per process (~1 s over a loaded box) and ate
# most of the driver's handshake window.
proc_lines() {
    local pat="$1" d pid arg cmd
    for d in /proc/[0-9]*; do
        pid="${d#/proc/}"
        cmd=""
        while IFS= read -r -d '' arg; do cmd+="$arg "; done < "$d/cmdline" 2>/dev/null
        [ -n "$cmd" ] || continue
        [[ "$cmd" =~ $pat ]] && printf '%s %s\n' "$pid" "$cmd"
    done
}

# same_prefix - true when pid belongs to THIS prefix: Proton-launched processes
# inherit STEAM_COMPAT_DATA_PATH in their environment (visible in
# /proc/<pid>/environ). Scoping kills to our own prefix avoids disrupting
# unrelated games that happen to use the same Proton build. Fail closed: when
# the environment can't be read we can't confirm it's ours, so report false
# and leave it alone (a foreign wineserver holding our prefix is handled on
# the next boot once its environ is readable; killing blind risks nuking an
# unrelated Wine app).
# The path is normalized (strip a leading /run/host) because SteamVR's Sniper
# sandbox can present host paths as /run/host/home/... while we were baked
# with the plain /home/... form.
same_prefix() {
    local env want
    [ -n "$1" ] || return 1
    [ -r "/proc/$1/environ" ] || return 1
    want="${STEAM_COMPAT_DATA_PATH#/run/host}"
    env=$(tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null \
        | sed 's#^STEAM_COMPAT_DATA_PATH=/run/host#STEAM_COMPAT_DATA_PATH=#' \
        | grep -x "STEAM_COMPAT_DATA_PATH=$want")
    [ -n "$env" ]
}

# steamvr_up - is a SteamVR server running? Boot-time files (the crash
# timestamp) are safe to touch any time; steamvr.vrsettings is not.
steamvr_up() {
    proc_lines 'SteamVR/bin/linux64/vrserver' 2>/dev/null | grep -q .
}

# clear_foreign_wineservers - kill any Wine process whose Proton differs from
# the one we run, so the launch is never blocked by cross-Proton prefix
# contention. Processes from OUR OWN Proton are left untouched (a running
# game/driver in the same prefix must not be disrupted), as are processes
# from other prefixes (an unrelated game using the same Proton build must
# not be disrupted either).
clear_foreign_wineservers() {
    local home_dir home_name
    home_dir="$(cd "$(dirname "$PROTON")" 2>/dev/null && pwd)"
    home_name=""
    # home proton dir is either .../compatibilitytools.d/<name> or .../steamapps/common/<name>
    home_name=$(printf '%s' "$home_dir" | sed -nE 's#.*/compatibilitytools\.d/([^/]+)/?$#\1#p')
    [ -z "$home_name" ] && home_name=$(printf '%s' "$home_dir" | sed -nE 's#.*/steamapps/common/([^/]+)/?$#\1#p')
    [ -z "$home_name" ] && return 0
    # Candidate scan: ONE pass over /proc cmdlines (see proc_lines above).
    # The earlier version read /proc/<pid>/environ for every wine-ish process
    # on the box, which cost ~5 s on a loaded system; that alone pushed the
    # server launch outside SteamVR's two-probe driver window (probe 2 fires
    # ~8 s after probe 1), and a late handshake reads back as VRInitError 105
    # / a driver that "won't load" at boot. Candidates are usually 0-3 PIDs.
    proc_lines 'wine|proton|ignition_server' | while IFS= read -r line; do
        pid="${line%% *}"; rest="${line#* }"
        [ -z "$rest" ] && continue
        case "$rest" in
            *wine*|*proton*|*ignition_server*) : ;;
            *) continue ;;
        esac
        pname=$(printf '%s' "$rest" | sed -nE 's#.*/compatibilitytools\.d/([^/]+)/.*#\1#p')
        [ -z "$pname" ] && pname=$(printf '%s' "$rest" | sed -nE 's#.*/steamapps/common/(Proton[^/]*)/.*#\1#p')
        # a `steam.exe .../ignition_server.exe` child doesn't embed the Proton
        # path; its parent is the Proton python/proton process, so fall back to
        # matching the running wine tree's Proton home. Match ONLY the proton
        # build dir - the broad `steamapps/common/<dir>` pattern also matches
        # the game dir (STEAM_COMPAT_INSTALL_PATH=.../Standable Full Body
        # Estimation), which made the driver's own server look "foreign" and
        # got it killed at every game launch.
        if [ -z "$pname" ] && [ -r "/proc/$pid/environ" ]; then
            pname=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null \
                | grep -Eo 'compatibilitytools\.d/[^/]+|steamapps/common/Proton[^/]*' \
                | head -1 | sed -E 's#.*/##')
        fi
        [ -z "$pname" ] && continue
        [ "$pname" = "$home_name" ] && continue
        # only our own prefix: a foreign-proton wineserver elsewhere is harmless
        same_prefix "$pid" || continue
        # per-pid kill (not pkill by build name): each foreign process in our
        # prefix is visited by this loop, so no broad pattern is needed and
        # other prefixes are never touched
        kill -9 "$pid" 2>/dev/null
    done
}

# reap_orphan_services - kill the leftover Wine tree from dead sessions: the
# Ignition server and the Wine service helpers (services/winedevice/rpcss/
# plugplay/explorer/...) it drags along. Ignition fork()s the server and never
# reaps it, so a crashed SteamVR reparents the whole tree to init; a stale tree
# in our prefix is what crashes the Steam Link driver on the next boot. Scoped
# hard: only in OUR prefix (STEAM_COMPAT_DATA_PATH) and only when detached from
# any live steam/wine/SteamVR launcher, so a running session and unrelated Wine
# apps are never touched.
reap_orphan_services() {
    local d pid pp rec
    local -A _pp=() _comm=()
    # ppid + comm for every process, fork-free.
    for d in /proc/[0-9]*; do
        pid="${d#/proc/}"
        pp=""
        while IFS= read -r rec; do
            case "$rec" in
                PPid:*) pp="${rec#PPid:}"; pp="${pp//[^0-9]/}"; break ;;
            esac
        done < "$d/status" 2>/dev/null
        [ -n "$pp" ] || continue
        _pp[$pid]="$pp"
        IFS= read -r comm < "$d/comm" 2>/dev/null
        _comm[$pid]="$comm"
    done
    # Never target our own ancestry.
    local -A _self=()
    pp="$$"
    while [ -n "$pp" ] && [ "$pp" != 0 ] && [ "$pp" != 1 ]; do
        _self[$pp]=1; pp="${_pp[$pp]:-}"
    done
    # attached - does pid's ancestry reach a live launcher before init?
    _attached() {
        local p="$1" c h=0
        while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$h" -lt 40 ]; do
            p="${_pp[$p]:-}"; [ -n "$p" ] || return 1
            c="${_comm[$p]}"
            case "$c" in
                steam|steam.sh|reaper|srt-bwrap|pv-adverb|pv-runtime|pressure-vessel*|python3|wine|wine64|wineserver|vrserver|vrmonitor|steamvr|wivrn-server|gamescope)
                    return 0 ;;
            esac
            h=$((h+1))
        done
        return 1
    }
    local killed=0
    for pid in "${!_comm[@]}"; do
        # comm truncates to 15 chars: ignition_server.exe -> "ignition_server".
        case "${_comm[$pid]}" in
            ignition_server*|wineserver|wineboot*|services*|winedevice*|plugplay*|rpcss*|explorer*|svchost*|conhost*) ;;
            *) continue ;;
        esac
        [ -n "${_self[$pid]+x}" ] && continue
        same_prefix "$pid" || continue
        _attached "$pid" && continue
        kill -9 "$pid" 2>/dev/null && killed=$((killed + 1))
    done
    [ "$killed" -gt 0 ] && logh "reaped $killed orphaned ignition/wine process(es)"
    return 0
}
