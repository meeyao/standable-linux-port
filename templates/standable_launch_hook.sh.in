#!/bin/bash
# Standable launch hook - set as Steam launch options:
#   bash ~/.local/bin/standable_launch_hook.sh %command%
#
# Runs the game in host context (direct $PROTON run, like the retired
# standable-gui) after repairing prefix state (s: link, VRChat
# link, driver re-enable, win_vrpath), so game and driver share ONE
# prefix/wineserver (split wineservers break their IPC and the game never
# reaches SteamVR) AND the game renders its desktop GUI window while SteamVR
# runs. %command% is deliberately ignored: chaining it registers the app as a
# VR overlay (steam.overlay.<appid>) and SteamVR drops it immediately - no
# window. SteamAppId/SteamGameId are exported below so Steam API auth works.
#
# NOTE: the Proton build and s: convention are resolved at runtime (see
# below), so switching Proton in Steam's Compatibility UI takes effect on
# the next launch with no reinstall. Only the game exe path is baked.

STEAM_COMPAT_DATA_PATH="@COMPAT@"
STEAM_COMPAT_CLIENT_INSTALL_PATH="@STEAM_ROOT@"
export STEAM_COMPAT_DATA_PATH STEAM_COMPAT_CLIENT_INSTALL_PATH
PROTON="@PROTON@"
GAME_DIR="@GAME_DIR@"

# Run under whatever Proton the game is actually using right now (same
# shared resolver as the driver shim): the prefix's own bookkeeping first
# (the outer Steam proton run just updated it), then Steam's forced tool,
# then the install-time PROTON above.
if [ -f "$GAME_DIR/bin/linux64/proton_resolve.sh" ]; then
    . "$GAME_DIR/bin/linux64/proton_resolve.sh"
    _R=$(proton_resolve "$STEAM_COMPAT_DATA_PATH" "@STEAM_ROOT@" "@APP_ID@" "$PROTON" 2>/dev/null)
    [ -n "$_R" ] && PROTON="$_R"
    unset _R
fi

# We launch via bare $PROTON run (sharing the driver's wineserver), which
# bypasses Steam's launcher that normally exports these. The game's Steamworks
# DRM needs to know which app it is, else SteamAPI_Init can't authenticate and
# the game shows "Steam authentication failed".
export SteamAppId="@APP_ID@"
export SteamGameId="@APP_ID@"

# In-VR overlay background may show a checkerboard pattern under a Proton whose
# D3D11 is stock DXVK; proton-cachyos-slr (the recommended build) renders it
# correctly. We don't layer a sarek build over the prefix anymore - cross-Proton
# DLL injection caused more trouble than the cosmetic fix was worth.

PFX="$STEAM_COMPAT_DATA_PATH/pfx"
S_LINK="$PFX/dosdevices/s:"
# s: convention follows the RUNNING Proton (recomputed: newer Valve Protons
# manage s: themselves via get_validated_steamapps_parent, older forks map it
# to steamapps). S_ROOT is the game library root (grandparent of GAME_DIR).
S_ROOT="$(cd "$GAME_DIR/../.." 2>/dev/null && pwd)"
[ -n "$S_ROOT" ] || S_ROOT="@STEAM_ROOT@"
if grep -q 'get_validated_steamapps_parent' "${PROTON%/proton}/proton" 2>/dev/null; then
    S_TARGET="$S_ROOT"
else
    S_TARGET="$S_ROOT/steamapps"
fi
fix_s() { ln -sfn "$S_TARGET" "$S_LINK" 2>/dev/null; }

# Stale-wineserver sweep lives in sweep.sh (shared with the driver shim);
# it needs PROTON + STEAM_COMPAT_DATA_PATH, both set above.
if [ -f "$GAME_DIR/bin/linux64/sweep.sh" ]; then
    . "$GAME_DIR/bin/linux64/sweep.sh"
fi
clear_foreign_wineservers
reap_orphan_services

fix_vrchat() {
    local src="@VRCHAT_VRC_DIR@"
    [ -n "$src" ] && [ -d "$src" ] || return 0
    local dst="$PFX/drive_c/users/steamuser/AppData/LocalLow/VRChat"
    # Replace a stale symlink-only layout (see install.sh); a dir with real
    # files is deliberate, leave it.
    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
        find "$dst" -mindepth 1 -type f 2>/dev/null | grep -q . && return 0
        rm -rf "$dst"
    fi
    mkdir -p "$(dirname "$dst")"
    ln -sfn "$src" "$dst"
}

# A crash leaves block markers that suppress the driver on the NEXT boot even
# when safe mode is off ("blocked by a previous safe mode event") in
# steamvr.vrsettings and vrserver_crash_timestamp.txt. Drop the timestamp
# always (read only at boot); edit settings only with SteamVR down, because a
# live change makes SteamVR re-evaluate drivers and a teardown crashes vrlink.
# This normally no-ops (the hook runs with SteamVR up); install clears settings.
reenable_driver() {
    rm -f "@STEAM_ROOT@/config/vrserver_crash_timestamp.txt"
    steamvr_up && return 0
    local cfg="@STEAM_ROOT@/config/steamvr.vrsettings"
    [ -f "$cfg" ] || return 0
    [ -f "$cfg.standable.bak" ] || cp -n "$cfg" "$cfg.standable.bak" 2>/dev/null
    python3 - "$cfg" <<'PY' >/dev/null 2>&1 || return 0
import json, sys
cfg = sys.argv[1]
d = json.load(open(cfg))
changed = False
ds = d.setdefault("driver_standable", {})
if ds.pop("blocked_by_safe_mode", None) is not None:
    changed = True
if ds.get("enable", True) is False:
    ds["enable"] = True
    changed = True
if d.get("steamvr", {}).get("enableSafeMode", False) is True:
    d["steamvr"]["enableSafeMode"] = False
    changed = True
if changed:
    json.dump(d, open(cfg, "w"), indent=3, sort_keys=False)
PY
}

fix_s
fix_vrchat
reenable_driver
# Keep the Windows-side driver registration clean (drops Linux paths and
# stale-convention S:\ variants the game otherwise accumulates).
if [ -x "$GAME_DIR/bin/linux64/win_vrpath.sh" ]; then
    "$GAME_DIR/bin/linux64/win_vrpath.sh" "$PFX" "$GAME_DIR" "$S_TARGET"
fi
( for i in $(seq 20); do sleep 3; [ -e "$S_LINK/" ] || fix_s; fix_vrchat; done ) &

# Launch in host context (like the retired standable-gui): direct $PROTON run
# of the game exe. This is what renders the desktop GUI window while SteamVR
# runs. Steam's own %command% is deliberately ignored: chaining it registers
# the app as a VR overlay (steam.overlay.<appid>) and SteamVR drops it
# immediately - no window, and the game exits. Direct run shares the same
# prefix/wineserver as the driver, so their IPC still works. The Steam API
# still authenticates because the Steam client is running and
# SteamAppId/SteamGameId are exported above.
# Log the launch (proton chosen + exit) so a dead-on-arrival GUI is traceable
# without another debug round-trip.
HOOK_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/standable/hook.log"
mkdir -p "$(dirname "$HOOK_LOG")"
{
    echo "=== $(date -Iseconds) launch ==="
    echo "proton: $PROTON"
    echo "game:   $GAME_DIR/Standable.exe"
    case "$0" in
        "$HOME/bin/"*) echo "NOTE: this hook moved to ~/.local/bin - update Steam Launch Options to: bash \$HOME/.local/bin/standable_launch_hook.sh %command%" ;;
    esac
} >> "$HOOK_LOG"
# Capture the game's own output so a dead-on-arrival GUI shows its error
# (Steam auth failure, OpenVR init, missing DLL) instead of just the exit code.
GAME_LOG="${XDG_STATE_HOME:-$HOME/.local/state}/standable/game.log"
"$PROTON" run "$GAME_DIR/Standable.exe" >> "$GAME_LOG" 2>&1
_code=$?
echo "exit:   $_code ($(date -Iseconds))" >> "$HOOK_LOG"
echo "--- game output above ---" >> "$HOOK_LOG"
exit $_code