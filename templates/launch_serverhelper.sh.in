#!/bin/bash
# launch_serverhelper.sh — spawn ignition_server.exe in shared host-context prefix.
# FIRING ORDER MATTERS: every "$PROTON run" triggers Proton prefix maintenance
# which DELETES custom dosdevices links (s:) mid-pass. Proton invocations go in
# background FIRST; s: is fixed immediately and a 60s repair loop heals any
# late pass. Never gate driver startup.
# NOTE: HKCU\Software\Wine\VR is NOT required (empirically verified 2026-08-23:
# GUI renders + T-pose works with key absent); vr_bootstrap.exe kept in prefix
# for diagnostics only.

unset SteamGameId

export STEAM_COMPAT_DATA_PATH="@COMPAT@"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="@STEAM_ROOT@"
PROTON="@PROTON@"

# Proton's launcher is `#!/usr/bin/env python3` but modern Proton builds need
# Python >= 3.11 (`from typing import Self`); SteamVR runs this driver under
# the Sniper sandbox, which only ships Python 3.9, so Proton would die on
# startup and trap SteamVR in its ~21 s watchdog. This script's directory
# contains a `python3` shim that selects a working interpreter (host python,
# or the Soldier runtime's python via its own loader), so prepend it for the
# `python3` heredocs and `$PROTON run` invocations below.
SCRIPT_DIR="$0"
case "$SCRIPT_DIR" in
    */*) SCRIPT_DIR="$(cd "${SCRIPT_DIR%/*}" && pwd)" ;;
    *) SCRIPT_DIR="$PWD" ;;
esac
case ":$PATH:" in
    *":$SCRIPT_DIR:"*) : ;;
    *) PATH="$SCRIPT_DIR:$PATH"; export PATH ;;
esac

# resolve_runtime_proton — honor whatever Proton Steam currently forces on the
# game, so a switch in Steam's Compatibility UI takes effect on the next
# SteamVR boot without re-running install (and the driver can never mismatch
# the game and fight it over the shared prefix). Steam records the compat
# tool in config.vdf (CompatToolMapping); the install-time PROTON above is
# the fallback when no forced tool is set, unresolvable, or Steam hasn't
# flushed config.vdf yet (it writes on exit). Must run before S_TARGET and
# any `$PROTON` use below.
resolve_runtime_proton() {
    local vdf="@STEAM_ROOT@/config/config.vdf" name cand
    [ -f "$vdf" ] || return 0
    name=$(python3 - "$vdf" "@APP_ID@" <<'PY' 2>/dev/null
import re, sys
try:
    s = open(sys.argv[1]).read()
except Exception:
    raise SystemExit(1)
m = re.search(r'"CompatToolMapping"\s*\{(.*?)\n\}', s, re.S)
if not m:
    raise SystemExit(1)
for app in re.finditer(r'"(\d+)"\s*\{(.*?)\n[ \t]*\}', m.group(1), re.S):
    if app.group(1) == sys.argv[2]:
        n = re.search(r'"name"\s+"([^"]+)"', app.group(2))
        if n:
            print(n.group(1)); raise SystemExit(0)
raise SystemExit(1)
PY
) || return 0
    [ -n "$name" ] || return 0
    for cand in "@STEAM_ROOT@/compatibilitytools.d/$name/proton" \
                "/usr/share/steam/compatibilitytools.d/$name/proton" \
                "@STEAM_ROOT@/steamapps/common/$name/proton" \
                "@STEAM_ROOT@/steamapps/common/Proton - $name/proton"; do
        if [ -x "$cand" ] && [ -d "$(dirname "$cand")/files/lib/wine" ]; then
            if [ "$cand" != "$PROTON" ]; then
                echo "launch_serverhelper: using Steam-forced Proton $(basename "$(dirname "$cand")") (deployed: $(basename "$(dirname "$PROTON")"))" >&2
                PROTON="$cand"
            fi
            return 0
        fi
    done
    return 0
}
resolve_runtime_proton
S_LINK="$STEAM_COMPAT_DATA_PATH/pfx/dosdevices/s:"
# Drive convention differs by Proton build: newer Valve Protons manage the
# s: drive themselves (gamedrive -> Steam PARENT dir, paths like
# S:\steamapps\common\...), older forks don't manage it (use steamapps dir,
# paths like S:\common\...). Match whichever the build enforces; the driver
# derives paths from its CWD mapping at runtime, so consistency is all that
# matters.
PROTON_DIR="$(dirname "$PROTON")"
if grep -q 'get_validated_steamapps_parent' "$PROTON_DIR/proton" 2>/dev/null; then
    S_TARGET="@S_ROOT@"
else
    S_TARGET="@S_ROOT@/steamapps"
fi
fix_s() { ln -sfn "$S_TARGET" "$S_LINK" 2>/dev/null; }

# same_prefix — true when pid belongs to THIS prefix: Proton-launched processes
# inherit STEAM_COMPAT_DATA_PATH in their environment (visible in
# /proc/<pid>/environ). Scoping kills to our own prefix avoids disrupting
# unrelated games that happen to use the same Proton build. When the
# environment can't be read, return true (fail-open: a foreign wineserver
# holding our prefix would otherwise wedge the driver past the watchdog).
same_prefix() {
    local env
    [ -n "$1" ] || return 0
    [ -r "/proc/$1/environ" ] || return 0
    env=$(tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null | grep -x "STEAM_COMPAT_DATA_PATH=$STEAM_COMPAT_DATA_PATH")
    [ -n "$env" ]
}

# clear_foreign_wineservers — the Ignition server must start in the prefix that
# THIS launch script's Proton owns. If another Proton build was ever launched in
# the same prefix and left a wineserver (or orphaned wineboot/winedevice/xalia
# clients) behind, the new wineserver cannot acquire the prefix lock and the
# driver's handshake stalls past SteamVR's ~21 s watchdog, hard-crashing it into
# safe mode. Kill any Wine process whose Proton differs from the one we run, so
# the driver launch is never blocked by cross-Proton prefix contention. Processes
# from OUR OWN Proton are left untouched (a running game/driver in the same
# prefix must not be disrupted), as are processes from other prefixes (an
# unrelated game using the same Proton build must not be disrupted either).
clear_foreign_wineservers() {
    local home_dir home_name pid args pname
    home_dir="$(cd "$(dirname "$PROTON")" 2>/dev/null && pwd)"
    home_name=""
    # home proton dir is either .../compatibilitytools.d/<name> or .../steamapps/common/<name>
    home_name=$(printf '%s' "$home_dir" | sed -nE 's#.*/compatibilitytools\.d/([^/]+)/?$#\1#p')
    [ -z "$home_name" ] && home_name=$(printf '%s' "$home_dir" | sed -nE 's#.*/steamapps/common/([^/]+)/?$#\1#p')
    [ -z "$home_name" ] && return 0
    # also accept the Steam-VR-prefixed built-ins like "Proton - Experimental"
    ps -eo pid=,args= 2>/dev/null | while read -r pid rest; do
        pname=$(printf '%s' "$rest" | sed -nE 's#.*/compatibilitytools\.d/([^/]+)/.*#\1#p')
        [ -z "$pname" ] && pname=$(printf '%s' "$rest" | sed -nE 's#.*/steamapps/common/(Proton[^/]*)/.*#\1#p')
        [ -z "$pname" ] && continue
        case "$rest" in
            *wine*|*proton*) : ;;
            *) continue ;;
        esac
        [ "$pname" = "$home_name" ] && continue
        # only our own prefix: a foreign-proton wineserver elsewhere is harmless
        same_prefix "$pid" || continue
        # per-pid kill (not pkill by build name): each foreign process in our
        # prefix is visited by this loop, so no broad pattern is needed and
        # other prefixes are never touched
        kill -9 "$pid" 2>/dev/null
    done
}

# Fix SteamVR state: a transient handshake timeout can leave the driver
# disabled or SteamVR in safe mode. Clear every blocker before driver load so
# standable gets a fresh chance each session. SteamVR records the driver as
# "blocked by a previous safe mode event" in two places:
#   * config/steamvr.vrsettings  -> driver_standable.blocked_by_safe_mode = true
#   * config/vrserver_crash_timestamp.txt  (the safe-mode trigger file)
# Clearing only `enable`/`enableSafeMode` is NOT enough: those two markers are
# what actually suppress standable on the next boot. Removing them here lets
# the driver re-attempt cleanly even after a prior watchdog abort.
fix_steamvr_state() {
    local cfg="@STEAM_ROOT@/config/steamvr.vrsettings"
    [ -f "$cfg" ] || return 0
    python3 - "$cfg" <<'PY' >/dev/null 2>&1 || return 0
import json, sys
cfg = sys.argv[1]
d = json.load(open(cfg))
changed = False
ds = d.setdefault("driver_standable", {})
if ds.pop("blocked_by_safe_mode", None) is not None:
    changed = True
if ds.get("enable", True) is False:
    ds["enable"] = True
    changed = True
if d.get("steamvr", {}).get("enableSafeMode", False) is True:
    d["steamvr"]["enableSafeMode"] = False
    changed = True
if changed:
    json.dump(d, open(cfg, "w"), indent=3, sort_keys=False)
PY
    # The crash-timestamp file is SteamVR's safe-mode trigger; drop it so a
    # fresh session isn't treated as a repeat of the previous abort.
    rm -f "/home/nick/.local/share/Steam/config/vrserver_crash_timestamp.txt"
}

# (SCRIPT_DIR PATH prepend + resolve_runtime_proton already ran near the top,
# before S_TARGET and any $PROTON use.)

# Auto-calibration: driver reads VRChat's IK log from
# %UserProfile%\AppData\LocalLow\VRChat\VRChat\output_log_*.txt in its own
# prefix; VRChat lives in a separate prefix (438100), so we link the two.
# Re-applied here because Proton prefix init can recreate LocalLow (wiping the
# link). No-op when VRChat isn't installed.
fix_vrchat() {
    local src="@VRCHAT_VRC_DIR@"
    [ -n "$src" ] && [ -d "$src" ] || return 0
    local dst="$STEAM_COMPAT_DATA_PATH/pfx/drive_c/users/steamuser/AppData/LocalLow/VRChat"
    [ -e "$dst" ] && [ ! -L "$dst" ] && return 0   # don't clobber real dir
    mkdir -p "$(dirname "$dst")"
    ln -sfn "$src" "$dst"
}

# PSVR2 Sense controller support (Ignition) — proton run, may wipe s:
# Free the prefix of any foreign-Proton leftover wineserver BEFORE we touch it:
# a stale one would block our server launch and trip SteamVR's watchdog.
clear_foreign_wineservers
"$PROTON" run reg import ./wine_psvr2_hidraw.reg >/dev/null 2>&1 &

fix_s
fix_vrchat
fix_steamvr_state
( for i in $(seq 20); do sleep 3; [ -e "$S_LINK/" ] || fix_s; fix_vrchat; done ) &

exec "$PROTON" run "$@"
