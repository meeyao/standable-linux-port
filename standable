#!/bin/bash
# standable — front door for the Standable FBE Linux patch.
# Usage: ./standable [install|check|uninstall|proton PATH]
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-help}" in
    install)
        exec "$DIR/install.sh" "${@:2}"
        ;;
    check|status)
        exec "$DIR/install.sh" --check
        ;;
    uninstall|remove)
        exec "$DIR/install.sh" --uninstall
        ;;
    proton)
        [ -n "${2:-}" ] || { echo "Usage: ./standable install --proton /path/to/proton" >&2; exit 1; }
        shift
        exec "$DIR/install.sh" "$@"
        ;;
    --version|-v)
        echo "standable v3.1.0"; exit 0;;
    help|--help|-h|*)
        cat <<EOF
Standable Full Body Estimation — Linux patch

Usage: ./standable <command>

  install            Install or repair (safe to re-run)
                       options: --proton /path/to/proton
  check              Verify the installed setup
  uninstall          Remove everything this patch added

Typical flow:
  ./standable install
  # set Steam launch options: bash ~/bin/standable_launch_hook.sh %command%
  # start SteamVR, then launch Standable from Steam
EOF
        ;;
esac
