#!/bin/bash
# standable — front door for the Standable FBE Linux patch.
# Usage: ./standable [install|check|uninstall] [options]
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-help}" in
    install)
        exec "$DIR/install.sh" "${@:2}"
        ;;
    check|status)
        exec "$DIR/install.sh" --check "${@:2}"
        ;;
    uninstall|remove)
        exec "$DIR/install.sh" --uninstall
        ;;
    proton)
        [ -n "${2:-}" ] || { echo "Usage: ./standable install --proton /path/to/proton" >&2; exit 1; }
        exec "$DIR/install.sh" --proton "$2"
        ;;
    --version|-v)
        echo "standable v3.1.0"; exit 0;;
    help|--help|-h|*)
        cat <<EOF
Standable Full Body Estimation — Linux patch

Usage: ./standable <command>

  install            Install or repair (safe to re-run)
                       options: --proton /path/to/proton
                       options: --build (rebuild the bridge from source)
                       options: --dry-run (print every command, change nothing)
                       options: --no-safemode (disable SteamVR Safe Mode)
  check              Verify the installed setup (writes full diagnostics)
  uninstall          Remove everything this patch added

Typical flow:
  ./standable install
  # set the launch hook in Steam Launch Options:
  #   bash ~/bin/standable_launch_hook.sh %command%
  # then start SteamVR and launch Standable from Steam to get the desktop
  # settings window. The hook is what shows the desktop GUI and keeps the
  # game and driver on the same Proton/prefix.

Logs: ~/.local/state/standable/{install,hook,serverhelper}.log
EOF
        ;;
esac
