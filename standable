#!/bin/bash
# standable - front door for the retired Standable FBE Linux patch.
# The repo is now only an uninstaller for older installs.
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-help}" in
    uninstall|remove)
        exec "$DIR/install.sh" --uninstall "${@:2}"
        ;;
    install|check|status)
        echo "This patch is retired: Standable now has official Linux support."
        echo "Install/launch Standable normally through Steam."
        echo "If you used an older version of this patch: ./standable uninstall"
        exit 0
        ;;
    --version|-v)
        echo "standable (retired)"; exit 0
        ;;
    help|--help|-h|*)
        cat <<EOF
Standable Full Body Estimation: the old Linux patch

Standable now supports Linux officially. This repo is only here to clean up
older installs.

Usage: ./standable <command>

  uninstall          Remove everything the patch added
                       options: --dry-run (print commands, change nothing)
                       options: --assume-yes (allow while SteamVR runs)

After uninstalling, run Steam's Verify integrity check for Standable:
  Standable -> Properties -> Installed Files -> "Verify integrity of game files"

I'm still working on the WiVRn port:
  https://github.com/meeyao/standable-wivrn-port
EOF
        ;;
esac
