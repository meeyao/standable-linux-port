+public:
+    // While SteamVR tears the driver down it un-owns devices but the game
+    // keeps submitting poses; stop forwarding them to avoid flooding a
+    // deactivated host (PoseUpdated: device owned by driver -1).
+    void SetForwardingEnabled(bool enabled) { forwarding_enabled_ = enabled; }
+    bool IsForwardingEnabled() const { return forwarding_enabled_; }
+
+    // Points at the single client-side real host (driver_standable.so) so the
+    // provider can stop pose forwarding during shutdown. Null elsewhere.
